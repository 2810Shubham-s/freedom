<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <style>
        body {
            background: linear-gradient(135deg, #2F3242 60%, #3a3d5c 100%);
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 40px;
        }
        svg {
            width: 320px;
            height: 420px;
        }
        .message-box {
            max-width: 400px;
            color: #FFF;
            font-family: 'Roboto', Arial, sans-serif;
            font-weight: 300;
            background: rgba(47, 50, 66, 0.85);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            padding: 40px 32px;
            text-align: left;
        }
        .message-box h1 {
            font-size: 72px;
            margin-bottom: 16px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .message-box p {
            font-size: 20px;
            margin-bottom: 32px;
            color: #cfd8dc;
        }
        .buttons-con .action-link-wrap {
            display: flex;
            gap: 16px;
        }
        .buttons-con .action-link-wrap a {
            background: #68c950;
            padding: 10px 28px;
            border-radius: 6px;
            color: #FFF;
            font-weight: bold;
            font-size: 16px;
            transition: background 0.3s, color 0.3s;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(104,201,80,0.15);
        }
        .buttons-con .action-link-wrap a:hover {
            background: #5A5C6C;
            color: #fff;
        }
        #Polygon-1, #Polygon-2, #Polygon-3, #Polygon-4, #Polygon-5 {
            animation: float 1s infinite ease-in-out alternate;
        }
        #Polygon-2 { animation-delay: .2s; }
        #Polygon-3 { animation-delay: .4s; }
        #Polygon-4 { animation-delay: .6s; }
        #Polygon-5 { animation-delay: .8s; }
        @keyframes float {
            100% { transform: translateY(20px); }
        }
        @media (max-width: 700px) {
            .container {
                flex-direction: column;
                gap: 0;
            }
            svg {
                margin-bottom: 24px;
                width: 260px;
                height: 340px;
            }
            .message-box {
                padding: 32px 16px;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <svg viewBox="0 0 837 1045" xmlns="http://www.w3.org/2000/svg">
            <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <path d="M353,9 L626.664028,170 L626.664028,487 L353,642 L79.3359724,487 L79.3359724,170 L353,9 Z" id="Polygon-1" stroke="#007FB2" stroke-width="6"></path>
                <path d="M78.5,529 L147,569.186414 L147,648.311216 L78.5,687 L10,648.311216 L10,569.186414 L78.5,529 Z" id="Polygon-2" stroke="#EF4A5B" stroke-width="6"></path>
                <path d="M773,186 L827,217.538705 L827,279.636651 L773,310 L719,279.636651 L719,217.538705 L773,186 Z" id="Polygon-3" stroke="#795D9C" stroke-width="6"></path>
                <path d="M639,529 L773,607.846761 L773,763.091627 L639,839 L505,763.091627 L505,607.846761 L639,529 Z" id="Polygon-4" stroke="#F2773F" stroke-width="6"></path>
                <path d="M281,801 L383,861.025276 L383,979.21169 L281,1037 L179,979.21169 L179,861.025276 L281,801 Z" id="Polygon-5" stroke="#36B455" stroke-width="6"></path>
            </g>
        </svg>
        <div class="message-box">
            <h1>404</h1>
            <p>Oops! The page you’re looking for doesn’t exist.<br>
            It might have been moved or deleted.</p>
            <div class="buttons-con">
                <div class="action-link-wrap">
                    <a onclick="history.back(-1)" class="link-button link-back-button">Go Back</a>
                    <a href="/home" class="link-button">Home Page</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>